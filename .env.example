# Copy to .env (never commit .env) or run `tgmode setup` and answer a few
# plain-language questions — it writes .env for you.
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REGION=na
TESLA_REDIRECT_URI=http://localhost:8080/callback

# Your cars: nickname=VIN pairs, comma-separated. A nickname alone works too
# (add the VIN later at pairing time). Find a VIN in the Tesla app under
# Controls -> Software.
TGM_VEHICLES=Model Y=,Model 3=

# The chat server this app exposes (OpenAI-compatible).
TGM_SERVER_HOST=127.0.0.1
TGM_SERVER_PORT=8644
TGM_SERVER_API_KEY=
TGM_MODEL_ID=tesla-girlfriend-mode

# Pluggable AI backend (any OpenAI-compatible API). Default: local Ollama.
# Set TGM_AI_MODE=never for built-in answers only — nothing leaves this computer.
TGM_AI_BASE_URL=http://localhost:11434/v1
TGM_AI_API_KEY=
TGM_AI_MODEL=llama3.1
TGM_AI_MODE=auto
TGM_AI_TIMEOUT_SECONDS=20
TGM_EMBEDDING_DIM=384
TGM_TOKEN_FILE=~/.tgm/tokens.json
TGM_DATA_DIR=~/.tgm
TGM_DRY_RUN=0

# On-device learning: auto = learn from trips together and suggest profile
# improvements (everything stays on this computer); off = record nothing.
TGM_LEARNING_MODE=auto

# Music on activation: her love-songs mix, through YOUR Spotify account on
# your active device (usually your phone, playing through the car). Tesla's
# Fleet API cannot pick a playlist inside the car's own Spotify app.
# Your Spotify token stays in .env only — never commit it.
TGM_MUSIC_ENABLED=1
TGM_SPOTIFY_PLAYLIST_URI=
TGM_SPOTIFY_SEARCH_PHRASE=love songs mix
TGM_SPOTIFY_ACCESS_TOKEN=

# Her profile. Setup fills these in — the address is geocoded once, stored
# only here, and never uploaded anywhere.
TGM_PARTNER_NAME=girlfriend
TGM_PRESET=runs_cold
TGM_PLACE_NAME=her place
TGM_PLACE_ADDRESS=
TGM_PLACE_LAT=
TGM_PLACE_LON=
TGM_PLACE_RADIUS_M=300

# Weather thresholds and her passenger-side preferences.
TGM_COOL_BELOW_F=65
TGM_WARM_FROM_F=78
TGM_COOL_PASSENGER_TEMP_F=73
TGM_MID_PASSENGER_TEMP_F=72
TGM_SEAT_HEATER_LEVEL=2
# Vent fan when the climate is running: low|medium|high|auto.
# NOTE: fan speed is a PROPOSED Tesla API feature (see API_PROPOSAL.md) —
# modelled and simulated today, ready when the API lands.
TGM_FAN_SPEED=low
TGM_WARM_WINDOWS_CRACK=1
TGM_FREEWAY_SPEED_MPH=55
